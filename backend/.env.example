APP_NAME=ClipForge AI
APP_ENV=development
DEBUG=true
HOST=127.0.0.1
PORT=8000
API_PREFIX=/api/v1

DATABASE_URL=sqlite:///./storage/clipforge.db
JWT_SECRET=clipforge-dev-secret-replace-in-production-with-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

STORAGE_ROOT=./storage
MAX_UPLOAD_MB=2048
ALLOWED_VIDEO_EXTENSIONS=.mp4,.mov,.mkv,.webm
MAX_VIDEO_DURATION_SECONDS=14400

WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=auto
AI_MAX_CONCURRENT_JOBS=1

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
DEFAULT_CLIP_DURATION=30
DEFAULT_OUTPUT_WIDTH=1080
DEFAULT_OUTPUT_HEIGHT=1920
DEFAULT_OUTPUT_FPS=30

CORS_ORIGINS=http://localhost:3000
